{
  "name": "@reiva5/spreadsheet-state",
  "version": "0.1.0",
  "description": "Reusable spreadsheet operations and JSON state persistence for JavaScript.",
  "type": "module",
  "exports": "./src/index.js",
  "files": ["src", "README.md"],
  "scripts": {
    "test": "node scripts/build-apps-script.js && node --test",
    "test:coverage": "node scripts/build-apps-script.js && node --test --experimental-test-coverage --test-coverage-include=src/** --test-coverage-include=game100/** --test-coverage-include=apps-script/** --test-coverage-include=web/** --test-coverage-include=scripts/**",
    "check": "node scripts/check.js",
    "build:apps-script": "node scripts/build-apps-script.js"
  },
  "engines": {
    "node": ">=22"
  }
}
